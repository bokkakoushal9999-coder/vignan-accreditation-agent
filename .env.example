# VFSTR AI Accreditation Agent – Environment Configuration
# Copy this file to .env and fill in any overrides before running.
# All variables have sensible defaults — no changes required for local development.

# === Backend FastAPI REST API ===
# Port for the FastAPI backend server (default: 8000)
BACKEND_PORT=8000

# Full base URL of the backend API (auto-resolved from BACKEND_PORT if not set)
# BACKEND_API_URL=http://127.0.0.1:8000

# === Streamlit Frontend ===
# Port for the Streamlit web application (default: 8501)
STREAMLIT_SERVER_PORT=8501

# === Database ===
# Absolute or relative path to the SQLite database file.
# Default: data/accreditation.db  (project-relative, auto-created on first run)
# ACCREDITATION_DB_PATH=data/accreditation.db

# === Network ===
# Host interface to bind to (default: 127.0.0.1 for local; use 0.0.0.0 for LAN)
HOST=127.0.0.1

# === Encoding (Windows) ===
PYTHONIOENCODING=utf-8
